# HTTP port the API listens on
PORT=3000

# SQLite database file (use :memory: for an ephemeral database)
DATABASE_URL=./data/ems.db

# Secret used to sign JWT access tokens.
# There is deliberately no default: provide a random value of at least 32 characters.
# The application refuses to start when this is missing or too short.
JWT_SECRET=

# Access token lifetime (for example: 1h, 15m, 7d)
JWT_EXPIRES_IN=1h

# bcrypt cost factor used when hashing passwords
BCRYPT_ROUNDS=12

# Credentials for the first Admin, created by `npm run seed`.
# Registration is Admin-only, so this is the only way to bootstrap the system.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
